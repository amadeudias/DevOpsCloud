---
import ArrowLeft from '@lucide/astro/icons/arrow-left';
import PostCard from '../../components/PostCard.astro';
import Base from '../../layouts/Base.astro';
import { CATEGORIAS, type CategoriaSlug } from '../../lib/categorias';
import { getPosts } from '../../lib/posts';

export function getStaticPaths() {
	return Object.keys(CATEGORIAS).map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug as CategoriaSlug;
const categoria = CATEGORIAS[slug];
const posts = (await getPosts()).filter((p) => p.data.category === slug);
---

<Base title={categoria.nome} description={categoria.descricao}>
	<section class="container-site pt-16">
		<a href="/categorias/" class="inline-flex items-center gap-1.5 text-sm text-muted hover:text-brand">
			<ArrowLeft class="size-4" /> Categorias
		</a>
		<span class="mt-8 block h-1 w-12 rounded-full" style={`background:${categoria.cor}`}></span>
		<h1 class="mt-4 text-4xl font-bold tracking-tight">{categoria.nome}</h1>
		<p class="mt-3 text-lg text-muted">{categoria.descricao}</p>
		{
			posts.length > 0 ? (
				<div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
					{posts.map((post) => (
						<PostCard post={post} />
					))}
				</div>
			) : (
				<p class="mt-10 rounded-2xl border border-dashed border-line p-10 text-center text-muted">
					Ainda não há artigos nesta categoria.
				</p>
			)
		}
	</section>
</Base>
