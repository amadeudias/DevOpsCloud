---
import Base from '../../layouts/Base.astro';
import { CATEGORIAS, type CategoriaSlug } from '../../lib/categorias';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
const contagem = (slug: CategoriaSlug) => posts.filter((p) => p.data.category === slug).length;
const slugs = Object.keys(CATEGORIAS) as CategoriaSlug[];
---

<Base title="Categorias" description="Artigos organizados por área: AWS, DevOps, Kubernetes, IaC, observabilidade, segurança e FinOps.">
	<section class="container-site pt-16">
		<h1 class="text-4xl font-bold tracking-tight">Categorias</h1>
		<ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{
				slugs.map((slug) => (
					<li>
						<a
							href={`/categorias/${slug}/`}
							class="block h-full rounded-2xl border border-line p-6 transition hover:border-brand/40"
						>
							<span class="block h-1 w-10 rounded-full" style={`background:${CATEGORIAS[slug].cor}`} />
							<p class="mt-4 font-semibold">{CATEGORIAS[slug].nome}</p>
							<p class="mt-1 text-sm text-muted">{CATEGORIAS[slug].descricao}</p>
							<p class="mt-4 text-xs text-muted">
								{contagem(slug)} {contagem(slug) === 1 ? 'artigo' : 'artigos'}
							</p>
						</a>
					</li>
				))
			}
		</ul>
	</section>
</Base>
