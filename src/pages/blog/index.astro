---
import PostCard from '../../components/PostCard.astro';
import Base from '../../layouts/Base.astro';
import { CATEGORIAS, type CategoriaSlug } from '../../lib/categorias';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
const usadas = [...new Set(posts.map((p) => p.data.category))] as CategoriaSlug[];
---

<Base title="Artigos" description="Todos os artigos sobre AWS, DevOps, Kubernetes, infraestrutura como código e observabilidade.">
	<section class="container-site pt-16">
		<h1 class="text-4xl font-bold tracking-tight">Artigos</h1>
		<p class="mt-3 text-lg text-muted">Projetos reais, aprendizados e tutoriais.</p>

		{
			usadas.length > 0 && (
				<nav aria-label="Categorias" class="mt-8 flex flex-wrap gap-2">
					{usadas.map((slug) => (
						<a
							href={`/categorias/${slug}/`}
							class="inline-flex items-center gap-2 rounded-full border border-line px-3 py-1.5 text-sm font-medium text-muted hover:border-brand/40 hover:text-fg"
						>
							<span class="size-2 rounded-full" style={`background:${CATEGORIAS[slug].cor}`} />
							{CATEGORIAS[slug].nome}
						</a>
					))}
				</nav>
			)
		}

		{
			posts.length > 0 ? (
				<div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
					{posts.map((post) => (
						<PostCard post={post} />
					))}
				</div>
			) : (
				<p class="mt-10 rounded-2xl border border-dashed border-line p-10 text-center text-muted">
					Os primeiros artigos estão a caminho.
				</p>
			)
		}
	</section>
</Base>
