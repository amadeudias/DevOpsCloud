---
import Activity from '@lucide/astro/icons/activity';
import ArrowDown from '@lucide/astro/icons/arrow-down';
import BellRing from '@lucide/astro/icons/bell-ring';
import FileCode from '@lucide/astro/icons/file-code';
import Gauge from '@lucide/astro/icons/gauge';
import Radar from '@lucide/astro/icons/radar';
import Ticket from '@lucide/astro/icons/ticket';
import Base from '../layouts/Base.astro';

type Status = 'planejado' | 'em andamento' | 'ativo';

const ESTILO_STATUS: Record<Status, string> = {
	planejado: 'bg-bg-soft text-muted',
	'em andamento': 'bg-accent/20 text-fg',
	ativo: 'bg-emerald-500/15 text-emerald-600 dark:text-emerald-400',
};

const ETAPAS: { icone: typeof Gauge; titulo: string; ferramenta: string; texto: string; status: Status }[] = [
	{
		icone: Gauge,
		titulo: 'Experiência real do usuário',
		ferramenta: 'Grafana Faro',
		texto: 'Um SDK leve no navegador envia Core Web Vitals, erros de JavaScript e navegação de cada visita.',
		status: 'planejado',
	},
	{
		icone: Radar,
		titulo: 'Verificação sintética',
		ferramenta: 'Grafana Synthetic Monitoring',
		texto: 'Sondas em diferentes regiões acessam o site a cada minuto e acompanham disponibilidade, latência e validade do certificado TLS.',
		status: 'planejado',
	},
	{
		icone: Activity,
		titulo: 'Armazenamento e painéis',
		ferramenta: 'Grafana Cloud',
		texto: 'Métricas, logs e eventos centralizados, com painéis de SLO de disponibilidade e desempenho.',
		status: 'planejado',
	},
	{
		icone: BellRing,
		titulo: 'Alertas no Microsoft Teams',
		ferramenta: 'Grafana Alerting + Workflows do Teams',
		texto: 'Regras para site fora do ar, degradação de desempenho, pico de erros e certificado perto de expirar, com mensagem no canal da equipe.',
		status: 'planejado',
	},
	{
		icone: Ticket,
		titulo: 'Abertura automática de chamado',
		ferramenta: 'Integração com ferramenta de chamados',
		texto: 'Alertas críticos viram chamado com severidade, contexto e link para o painel; o chamado é resolvido quando o alerta normaliza.',
		status: 'planejado',
	},
	{
		icone: FileCode,
		titulo: 'Tudo como código',
		ferramenta: 'Terraform + GitHub Actions',
		texto: 'Verificações, regras de alerta e pontos de contato versionados no repositório e aplicados pelo pipeline.',
		status: 'planejado',
	},
];
---

<Base
	title="Observabilidade"
	description="Como este blog é monitorado como um sistema de produção: dados reais de usuários, verificações sintéticas, alertas no Teams e abertura automática de chamados."
>
	<section class="container-site max-w-4xl pt-16">
		<p class="text-xs font-semibold tracking-widest text-brand uppercase">Projeto</p>
		<h1 class="mt-3 text-4xl font-bold tracking-tight text-balance">Observabilidade de ponta a ponta</h1>
		<p class="mt-4 text-lg leading-relaxed text-muted">
			Um blog estático é simples, e por isso é um bom laboratório. A proposta é tratar este site como um serviço em
			produção: medir a experiência de quem acessa, detectar falhas antes dos visitantes, avisar a equipe no lugar certo e
			registrar cada incidente, com toda a configuração versionada como código.
		</p>

		<ol class="mt-12 space-y-2">
			{
				ETAPAS.map(({ icone: Icone, titulo, ferramenta, texto, status }, i) => (
					<li>
						{i > 0 && <ArrowDown class="mx-auto mb-2 size-4 text-muted" aria-hidden="true" />}
						<div class="flex gap-4 rounded-2xl border border-line bg-bg p-5 sm:p-6">
							<span class="grid size-11 shrink-0 place-items-center rounded-xl bg-brand-soft text-brand">
								<Icone class="size-5" />
							</span>
							<div class="min-w-0 flex-1">
								<div class="flex flex-wrap items-center justify-between gap-2">
									<h2 class="font-semibold">{titulo}</h2>
									<span class:list={['rounded-full px-2.5 py-0.5 text-xs font-medium', ESTILO_STATUS[status]]}>
										{status}
									</span>
								</div>
								<p class="mt-0.5 font-mono text-xs text-brand">{ferramenta}</p>
								<p class="mt-2 text-sm leading-relaxed text-muted">{texto}</p>
							</div>
						</div>
					</li>
				))
			}
		</ol>

		<p class="mt-12 rounded-2xl border border-dashed border-line p-6 text-sm text-muted">
			Esta página acompanha a implementação. Cada etapa concluída vira um artigo explicando decisões, configuração e o que
			aprendi no caminho.
		</p>
	</section>
</Base>
