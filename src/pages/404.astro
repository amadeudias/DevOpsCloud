---
import Base from '../layouts/Base.astro';
---

<Base title="Página não encontrada" description="A página que você procura não existe ou mudou de endereço.">
	<section class="container-site flex flex-col items-center py-32 text-center">
		<p class="font-mono text-sm text-brand">HTTP 404</p>
		<h1 class="mt-3 text-4xl font-bold tracking-tight">Página não encontrada</h1>
		<p class="mt-3 text-muted">O endereço pode ter mudado com a nova versão do blog.</p>
		<a href="/" class="mt-8 rounded-lg bg-brand-strong px-5 py-2.5 text-sm font-semibold text-white hover:brightness-110">
			Voltar ao início
		</a>
	</section>
</Base>
