---
import { type Post, formatarData, tempoDeLeitura } from '../lib/posts';
import CategoriaBadge from './CategoriaBadge.astro';

interface Props {
	post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, category, draft } = post.data;
---

<article
	class="group relative flex flex-col gap-3 rounded-2xl border border-line bg-bg p-6 transition hover:-translate-y-0.5 hover:border-brand/40 hover:shadow-lg hover:shadow-brand/5"
>
	<div class="flex items-center gap-3 text-xs text-muted">
		<CategoriaBadge slug={category} />
		<time datetime={pubDate.toISOString()}>{formatarData(pubDate)}</time>
		<span aria-hidden="true">·</span>
		<span>{tempoDeLeitura(post)} min</span>
		{draft && <span class="rounded bg-accent/20 px-1.5 py-0.5 font-medium text-fg">rascunho</span>}
	</div>
	<h3 class="text-lg leading-snug font-semibold tracking-tight">
		<a href={`/blog/${post.id}/`} class="after:absolute after:inset-0 group-hover:text-brand">{title}</a>
	</h3>
	<p class="line-clamp-3 text-sm leading-relaxed text-muted">{description}</p>
</article>
