---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { AUTOR } from '../consts';

// Para usar uma foto, basta adicionar src/assets/foto-perfil.jpg (ou .jpeg, .png, .webp)
const fotos = import.meta.glob<{ default: ImageMetadata }>('../assets/foto-perfil.{jpg,jpeg,png,webp}', {
	eager: true,
});
const foto = Object.values(fotos)[0]?.default;

interface Props {
	/** Lado em pixels, usado para gerar a imagem no tamanho certo */
	tamanho: number;
	class?: string;
}

const { tamanho, class: classe } = Astro.props;
---

{
	foto ? (
		<Image
			src={foto}
			alt={`Foto de ${AUTOR.nome}`}
			width={tamanho * 2}
			height={tamanho * 2}
			class:list={['shrink-0 object-cover', classe]}
			style={`width:${tamanho}px;height:${tamanho}px`}
		/>
	) : (
		<span
			class:list={['grid shrink-0 place-items-center bg-gradient-to-br from-brand to-sky-500 font-bold text-white', classe]}
			style={`width:${tamanho}px;height:${tamanho}px;font-size:${Math.round(tamanho * 0.36)}px`}
			aria-hidden="true"
		>
			AD
		</span>
	)
}
